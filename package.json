{
  "name": "omnevum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/stamp-service-worker.mjs",
    "preview": "vite preview",
    "fixture:effect": "node scripts/effect-loopback-fixture.mjs",
    "preview:effect-fixture": "node scripts/preview-effect-fixture.mjs",
    "benchmark:fresh-agent": "node scripts/fresh-agent-resume-benchmark.mjs",
    "benchmark:finance-phase4": "node scripts/finance-phase4-benchmark.mjs",
    "benchmark:finance-phase0": "node scripts/finance-phase0-benchmark.mjs",
    "benchmark:launchpad-transplant": "node scripts/launchpad-transplant-benchmark.mjs",
    "benchmark:platform-recovery": "node scripts/platform-recovery-benchmark.mjs",
    "benchmark:fresh-package-handoff": "node scripts/fresh-package-handoff-benchmark.mjs",
    "benchmark:factory": "vitest run src/core/factory.test.ts",
    "benchmark:factory-interruption": "node scripts/factory-interruption-benchmark.mjs",
    "benchmark:ordinary-use": "node scripts/ordinary-use-benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:service-worker": "node --test scripts/stamp-service-worker.test.mjs",
    "test:watch": "vitest",
    "generate:control": "node scripts/generate-control.mjs",
    "audit:structure": "node scripts/structure-audit.mjs",
    "audit:architecture": "node scripts/architecture-audit.mjs",
    "audit:static": "node scripts/static-audit.mjs",
    "audit:recovery": "node scripts/recovery-audit.mjs",
    "audit:references": "node scripts/reference-audit.mjs",
    "audit:acceptance": "node scripts/acceptance-audit.mjs",
    "audit:licenses": "node scripts/license-audit.mjs",
    "audit:security": "npm audit --audit-level=high",
    "audit:drift": "npm run generate:control && git diff --exit-code -- docs/control",
    "ci": "npm run generate:control && npm run audit:structure && npm run audit:references && npm run audit:acceptance && npm run benchmark:ordinary-use && npm run benchmark:finance-phase0 && npm run benchmark:finance-phase4 && npm run benchmark:launchpad-transplant && npm run benchmark:platform-recovery && npm run benchmark:fresh-package-handoff && npm run audit:architecture && npm run audit:licenses && npm run audit:security && npm run typecheck && npm test && npm run test:service-worker && npm run build && npm run audit:static && npm run audit:recovery && npm run audit:drift && git diff --check"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "minisearch": "7.2.0"
  }
}
